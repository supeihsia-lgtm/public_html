<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>9月运营月度报告 · HIGo旅行</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }
        body {
            background: #f4f7fd;
            padding: 12px 10px 28px;
            color: #1d2d44;
            font-size: 14px;
            line-height: 1.5;
        }
        .dashboard {
            max-width: 480px;
            margin: 0 auto;
        }

        /* HEADER */
        .header {
            margin-bottom: 14px;
            padding: 0 2px;
        }
        .header h1 {
            font-size: 19px;
            font-weight: 700;
            color: #0a1e33;
            line-height: 1.3;
        }
        .header h1 small {
            display: block;
            font-size: 12px;
            font-weight: 400;
            color: #5e6f8d;
            margin-top: 3px;
        }
        .header .date-badge {
            display: inline-block;
            margin-top: 8px;
            background: white;
            padding: 4px 12px;
            border-radius: 30px;
            font-size: 11px;
            color: #1a3a5c;
            border: 1px solid #e2e9f2;
        }

        /* KPI */
        .kpi-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-bottom: 14px;
        }
        .kpi-card {
            background: white;
            border-radius: 14px;
            padding: 12px 13px;
            border: 1px solid #edf2f9;
            box-shadow: 0 2px 8px rgba(0, 20, 50, 0.03);
        }
        .kpi-label {
            font-size: 11px;
            color: #5e6f8d;
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 3px;
        }
        .kpi-number {
            font-size: 20px;
            font-weight: 700;
            color: #0a1e33;
            letter-spacing: -0.3px;
        }
        .kpi-number small {
            font-size: 11px;
            font-weight: 400;
            color: #5e6f8d;
            margin-left: 2px;
        }
        .kpi-sub {
            font-size: 10.5px;
            color: #5e6f8d;
            margin-top: 2px;
            line-height: 1.4;
        }
        .kpi-card.green { border-left: 3px solid #0d7c3f; background: #f8fefb; }
        .kpi-card.orange { border-left: 3px solid #d9822b; background: #fefaf5; }
        .kpi-card.red { border-left: 3px solid #bc4b4b; background: #fef8f8; }
        .kpi-card.blue { border-left: 3px solid #2a6b9c; background: #f5faff; }
        .kpi-number.green { color: #0d7c3f; }
        .kpi-number.orange { color: #d9822b; }
        .kpi-number.red { color: #bc4b4b; }
        .kpi-number.blue { color: #2a6b9c; }

        .badge-up { color: #0d7c3f; background: #e3f5ec; padding: 0 7px; border-radius: 20px; font-size: 10px; font-weight: 600; }
        .badge-down { color: #b13a3a; background: #fce9e9; padding: 0 7px; border-radius: 20px; font-size: 10px; font-weight: 600; }
        .badge-down-critical { color: #8a1a1a; background: #fcd9d9; padding: 0 7px; border-radius: 20px; font-size: 10px; font-weight: 700; }
        .badge-neutral { color: #a67c1e; background: #fef4d9; padding: 0 7px; border-radius: 20px; font-size: 10px; font-weight: 600; }
        .badge-green { color: #0d7c3f; background: #e3f5ec; padding: 0 7px; border-radius: 20px; font-size: 10px; font-weight: 600; }

        /* CARD */
        .card {
            background: white;
            border-radius: 16px;
            padding: 14px 14px 16px;
            border: 1px solid #edf2f9;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
            margin-bottom: 14px;
        }
        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: #1a2c48;
            display: flex;
            align-items: center;
            gap: 7px;
            border-bottom: 1px solid #f0f4fa;
            padding-bottom: 9px;
            margin-bottom: 12px;
        }
        .card-title i { color: #2a6b9c; width: 18px; font-size: 14px; }
        .title-badge {
            margin-left: auto;
            font-size: 10px;
            font-weight: 600;
            padding: 2px 9px;
            border-radius: 20px;
        }
        .title-badge.green { background: #e3f5ec; color: #0d7c3f; }
        .title-badge.orange { background: #fef4d9; color: #a67c1e; }
        .title-badge.red { background: #fce9e9; color: #b13a3a; }
        .title-badge.blue { background: #e3ecf5; color: #1a5c8c; }
        .title-badge.purple { background: #ede7f6; color: #5e3a8c; }

        /* TABLE SCROLL */
        .table-wrap {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            margin: 0 -4px;
            padding: 0 4px;
        }
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 12px;
            min-width: 360px;
        }
        .data-table th {
            text-align: left;
            padding: 6px 5px 6px 0;
            font-weight: 600;
            color: #3d4f6a;
            border-bottom: 1px solid #eaeef4;
            font-size: 11px;
            white-space: nowrap;
        }
        .data-table td {
            padding: 7px 5px 7px 0;
            border-bottom: 1px solid #f2f6fc;
            color: #1d2d44;
            font-size: 12px;
            white-space: nowrap;
        }
        .data-table tr:last-child td { border-bottom: none; }
        .text-right { text-align: right; }
        .highlight-green { color: #0d7c3f; font-weight: 600; }
        .highlight-red { color: #b13a3a; font-weight: 600; }

        /* ALERT BOXES */
        .info-box {
            background: #f0f6fe;
            border-left: 3px solid #1a5c8c;
            padding: 10px 12px;
            border-radius: 8px;
            margin-top: 10px;
            font-size: 12px;
            color: #0b2a47;
            line-height: 1.6;
        }
        .success-box {
            background: #eaf7f0;
            border-left: 3px solid #0d7c3f;
            padding: 10px 12px;
            border-radius: 8px;
            margin-top: 10px;
            font-size: 12px;
            color: #0b2a47;
            line-height: 1.6;
        }
        .alert-box {
            background: #fcf2f2;
            border-left: 3px solid #bc4b4b;
            padding: 10px 12px;
            border-radius: 8px;
            margin-top: 10px;
            font-size: 12px;
            color: #0b2a47;
            line-height: 1.6;
        }
        .conclusion-box {
            background: #f0f6fe;
            border-radius: 10px;
            padding: 12px 14px;
            margin-top: 12px;
            border-left: 3px solid #1a5c8c;
            font-size: 12.5px;
            color: #0b2a47;
            line-height: 1.7;
        }
        .conclusion-box .danger-text { color: #8a1a1a; font-weight: 700; }
        .conclusion-box .green-text { color: #0d7c3f; font-weight: 700; }

        /* FLOW */
        .flow-row {
            display: flex;
            justify-content: space-between;
            border-bottom: 1px solid #f0f4fa;
            padding: 7px 0;
            font-size: 12.5px;
        }
        .flow-row:last-child { border-bottom: none; }
        .flow-row .label { color: #3d4f6a; display: flex; align-items: center; gap: 5px; }
        .flow-row .value { font-weight: 600; color: #0a1e33; }
        .flow-row .sub { font-size: 11px; color: #5e6f8d; font-weight: 400; margin-left: 3px; }

        /* DEST CARDS */
        .dest-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .dest-item {
            background: #f8faff;
            border-radius: 12px;
            padding: 12px 13px;
            border: 1px solid #eaeef4;
            border-left: 4px solid #2a6b9c;
        }
        .dest-item.roi-high { border-left-color: #0d7c3f; }
        .dest-item.roi-mid { border-left-color: #d9822b; }
        .dest-item.roi-low { border-left-color: #bc4b4b; }
        .dest-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 6px;
        }
        .dest-name { font-weight: 700; font-size: 14px; color: #1a2c48; }
        .dest-roi { font-size: 13px; font-weight: 700; color: #0d7c3f; }
        .dest-grid-mini {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 6px;
            margin-top: 4px;
        }
        .dest-grid-mini .item {
            text-align: center;
            background: white;
            border-radius: 8px;
            padding: 6px 4px;
        }
        .dest-grid-mini .item .num {
            font-size: 14px;
            font-weight: 700;
            color: #0a1e33;
        }
        .dest-grid-mini .item .lbl {
            font-size: 10px;
            color: #5e6f8d;
            margin-top: 1px;
        }
        .dest-meta {
            font-size: 10.5px;
            color: #5e6f8d;
            margin-top: 6px;
            line-height: 1.5;
        }

        /* PLAN */
        .plan-list {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .plan-item {
            background: #f8faff;
            border-radius: 12px;
            padding: 13px 14px;
            border: 1px solid #eaeef4;
            border-left: 4px solid #2a6b9c;
        }
        .plan-item.priority-s { border-left-color: #bc4b4b; background: #fef8f8; }
        .plan-item.priority-a { border-left-color: #d9822b; background: #fefaf5; }
        .plan-item.priority-b { border-left-color: #0d7c3f; background: #f8fefb; }
        .plan-item.priority-c { border-left-color: #1a5c8c; background: #f5faff; }
        .plan-title {
            font-weight: 700;
            font-size: 13.5px;
            color: #1a2c48;
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }
        .plan-title .badge {
            font-size: 9px;
            font-weight: 700;
            padding: 1px 7px;
            border-radius: 20px;
        }
        .badge.s { background: #fcd9d9; color: #8a1a1a; }
        .badge.a { background: #fef4d9; color: #a67c1e; }
        .badge.b { background: #e3f5ec; color: #0d7c3f; }
        .badge.c { background: #e3ecf5; color: #1a5c8c; }
        .plan-detail {
            font-size: 12px;
            color: #3d4f6a;
            margin-top: 6px;
            line-height: 1.6;
        }
        .plan-detail ul {
            padding-left: 16px;
            margin-top: 3px;
        }
        .plan-detail li { margin-bottom: 2px; }
        .plan-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 8px;
            font-size: 11px;
            color: #5e6f8d;
            border-top: 1px solid #eaeef4;
            padding-top: 8px;
        }
        .plan-meta .label { font-weight: 600; color: #1a2c48; }

        /* CONCLUSION */
        .conclusion-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }
        .conclusion-item {
            background: #f8faff;
            padding: 12px 13px;
            border-radius: 12px;
        }
        .conclusion-item .head {
            font-weight: 700;
            font-size: 13px;
            margin-bottom: 4px;
        }
        .conclusion-item .body {
            font-size: 12px;
            color: #3d4f6a;
            line-height: 1.6;
        }

        .footer {
            text-align: center;
            font-size: 11px;
            color: #8a9bb5;
            border-top: 1px solid #e2e9f2;
            padding-top: 14px;
            margin-top: 18px;
        }

        /* 移动端表格改卡片（可选，这里保留滚动） */
        @media (max-width: 360px) {
            .kpi-grid { grid-template-columns: 1fr 1fr; gap: 8px; }
            .kpi-number { font-size: 18px; }
            .data-table { font-size: 11px; min-width: 320px; }
        }
    </style>
</head>
<body>
<div class="dashboard">

    <!-- HEADER -->
    <div class="header">
        <h1>📊 9月运营月度报告
            <small>富国岛包机专线 · 投入产出 &amp; 大盘对标</small>
        </h1>
        <span class="date-badge"><i class="far fa-calendar-alt"></i> 数据截止 2026.9.30</span>
    </div>

    <!-- KPI -->
    <div class="kpi-grid">
        <div class="kpi-card green">
            <div class="kpi-label"><i class="fas fa-coins" style="color:#0d7c3f;"></i> 总广告消耗</div>
            <div class="kpi-number green">¥43,052</div>
            <div class="kpi-sub">富国岛 ¥19,430 · 中亚 ¥12,222</div>
        </div>
        <div class="kpi-card blue">
            <div class="kpi-label"><i class="fas fa-users" style="color:#2a6b9c;"></i> 总进线 / 开口</div>
            <div class="kpi-number blue">3,330 <small>进</small> / 2,492 <small>开</small></div>
            <div class="kpi-sub">付费开口 1,688 · 自然开口 804</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-label"><i class="fas fa-message" style="color:#0d7c3f;"></i> 留资数 · 留资率</div>
            <div class="kpi-number green">1,151</div>
            <div class="kpi-sub">留资率 <strong>67.39%</strong> <span class="badge-up">↑3.28pp</span></div>
        </div>
        <div class="kpi-card orange">
            <div class="kpi-label"><i class="fas fa-ticket-alt" style="color:#d9822b;"></i> 订单 · 收客</div>
            <div class="kpi-number orange">54 <small>单</small> / 175 <small>人</small></div>
            <div class="kpi-sub">核销率 2.17% · 人数核销 7.02%</div>
        </div>
        <div class="kpi-card green">
            <div class="kpi-label"><i class="fas fa-chart-line" style="color:#0d7c3f;"></i> 9月总毛利</div>
            <div class="kpi-number green">¥140,098</div>
            <div class="kpi-sub">富国岛 ¥48,072 · 中亚 ¥46,964</div>
        </div>
        <div class="kpi-card blue">
            <div class="kpi-label"><i class="fas fa-bullseye" style="color:#2a6b9c;"></i> 整体 ROI</div>
            <div class="kpi-number blue">3.25 <small>x</small></div>
            <div class="kpi-sub">广告费 ¥43,052 → 毛利 ¥140,098</div>
        </div>
    </div>

    <!-- 8月 vs 9月 -->
    <div class="card">
        <div class="card-title"><i class="fas fa-chart-line"></i> 8月 vs 9月 核心对比 <span class="title-badge orange">增长与落后</span></div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>指标</th><th class="text-right">8月</th><th class="text-right">9月</th><th class="text-right">变化</th></tr>
                </thead>
                <tbody>
                    <tr><td>广告消耗</td><td class="text-right">¥49,889</td><td class="text-right">¥43,052</td><td class="text-right"><span class="badge-down">↓13.7%</span></td></tr>
                    <tr><td>总进线</td><td class="text-right">4,077</td><td class="text-right">3,330</td><td class="text-right"><span class="badge-down">↓18.3%</span></td></tr>
                    <tr><td>总开口</td><td class="text-right">3,195</td><td class="text-right">2,492</td><td class="text-right"><span class="badge-down">↓22.0%</span></td></tr>
                    <tr><td>总留资</td><td class="text-right">1,306</td><td class="text-right">1,151</td><td class="text-right"><span class="badge-down">↓11.9%</span></td></tr>
                    <tr><td>留资率</td><td class="text-right">64.11%</td><td class="text-right highlight-green">67.39%</td><td class="text-right"><span class="badge-up">↑3.28pp</span></td></tr>
                    <tr><td>总订单</td><td class="text-right">56</td><td class="text-right">54</td><td class="text-right"><span class="badge-neutral">↓3.6%</span></td></tr>
                    <tr><td>总收客</td><td class="text-right">157</td><td class="text-right">175</td><td class="text-right"><span class="badge-up">↑11.5%</span></td></tr>
                    <tr><td>订单核销率</td><td class="text-right">1.75%</td><td class="text-right">2.17%</td><td class="text-right"><span class="badge-up">↑0.42pp</span></td></tr>
                    <tr><td>人数核销率</td><td class="text-right">4.91%</td><td class="text-right">7.02%</td><td class="text-right"><span class="badge-up">↑2.11pp</span></td></tr>
                    <tr><td>总毛利</td><td class="text-right">¥109,776</td><td class="text-right">¥140,098</td><td class="text-right"><span class="badge-up">↑27.6%</span></td></tr>
                    <tr><td>整体 ROI</td><td class="text-right">2.20x</td><td class="text-right highlight-green">3.25x</td><td class="text-right"><span class="badge-up">↑1.05x</span></td></tr>
                </tbody>
            </table>
        </div>
        <div class="info-box">
            <i class="fas fa-bullhorn" style="color:#1a5c8c;"></i>
            <strong>核心发现：</strong> 消耗降 13.7%，留资率提升 3.28pp，ROI 从 2.20x 升至 3.25x，毛利增 27.6%。
            <span style="color:#8a1a1a; font-weight:700;">但进线与开口分别下滑 18.3% 和 22.0%，流量规模收缩。</span>
        </div>
    </div>

    <!-- 流量漏斗 -->
    <div class="card">
        <div class="card-title"><i class="fas fa-funnel-dollar"></i> 流量转化漏斗 <span class="title-badge blue">9月全量</span></div>
        <div class="flow-row"><span class="label"><i class="fas fa-door-open" style="color:#2a6b9c;"></i> 总进线</span><span class="value">3,330 <span class="sub">(100%)</span></span></div>
        <div class="flow-row"><span class="label" style="padding-left:16px;"><i class="fas fa-arrow-right" style="color:#5e6f8d;"></i> 付费进线</span><span class="value">2,020 <span class="sub">(60.7%)</span></span></div>
        <div class="flow-row"><span class="label" style="padding-left:16px;"><i class="fas fa-leaf" style="color:#0d7c3f;"></i> 自然进线</span><span class="value">1,310 <span class="sub">(39.3%)</span></span></div>
        <div class="flow-row"><span class="label"><i class="fas fa-comment" style="color:#d9822b;"></i> 总开口</span><span class="value">2,492 <span class="sub">(74.8%)</span></span></div>
        <div class="flow-row"><span class="label" style="padding-left:16px;"><i class="fas fa-arrow-right" style="color:#5e6f8d;"></i> 付费开口</span><span class="value">1,688 <span class="sub">(67.7%)</span></span></div>
        <div class="flow-row"><span class="label" style="padding-left:16px;"><i class="fas fa-leaf" style="color:#0d7c3f;"></i> 自然开口</span><span class="value">804 <span class="sub">(32.3%)</span></span></div>
        <div class="flow-row"><span class="label"><i class="fas fa-file-signature" style="color:#1a5c8c;"></i> 总留资</span><span class="value">1,151 <span class="sub">(留资率 67.39%)</span></span></div>
        <div class="flow-row"><span class="label"><i class="fas fa-ticket-alt" style="color:#d9822b;"></i> 总订单</span><span class="value">54 <span class="sub">(核销率 2.17%)</span></span></div>
        <div class="flow-row"><span class="label"><i class="fas fa-user-friends" style="color:#0d7c3f;"></i> 总收客</span><span class="value">175 <span class="sub">(人数核销 7.02%)</span></span></div>
        <div class="success-box">
            <i class="fas fa-check-circle" style="color:#0d7c3f;"></i>
            <strong>自然进线占比 39.3%</strong> — 1,310 条免费进线，节省广告费约 ¥27,903。
        </div>
    </div>

    <!-- 成本与大盘对标 -->
    <div class="card">
        <div class="card-title"><i class="fas fa-rocket" style="color:#0d7c3f;"></i> 成本与大盘对标 <span class="title-badge green">碾压大盘</span></div>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>指标</th><th class="text-right">我司</th><th class="text-right">大盘</th><th class="text-right">对标</th></tr>
                </thead>
                <tbody>
                    <tr><td>CTR</td><td class="text-right highlight-green">8.5%~10.5%</td><td class="text-right">7.53%~10.53%</td><td class="text-right"><span class="badge-green">✅达标</span></td></tr>
                    <tr><td>CPC</td><td class="text-right highlight-green">≈¥0.75</td><td class="text-right">¥1.92~2.68</td><td class="text-right"><span class="badge-green">✅碾压</span></td></tr>
                    <tr><td>进线成本</td><td class="text-right highlight-green">≈¥12.9</td><td class="text-right">¥59.52~83.20</td><td class="text-right"><span class="badge-green">✅碾压</span></td></tr>
